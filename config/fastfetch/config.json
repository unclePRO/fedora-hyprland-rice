{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/kitty.png",
    "width": 18,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": "magenta"
  },
  "modules": [
    "break",
    { "type": "custom", "format": "╭───────────────────╮" },
    { "type": "title", "key": "│  user   ", "format": "{1}" },
    { "type": "title", "key": "│ 󰒋 hname  ", "format": "{2}" },
    { "type": "uptime", "key": "│ 󰅐 uptime " },
    { "type": "kernel", "key": "│  kernel " },
    { "type": "terminal", "key": "│  term   " },
    { "type": "shell", "key": "│  shell  " },
    { "type": "cpu", "key": "│  cpu    " },
    { "type": "disk", "key": "│ 󰋊 disk   " },
    { "type": "memory", "key": "│  memory " },
    { "type": "localip", "key":"│ 󰩟 network" },
    { "type": "custom", "format": "╰───────────────────╯" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
