{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin": 0,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/linux",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "bluetooth",
    "backlight",
    "wireplumber",
    "battery",
    "custom/controlcenter"
  ],

  "custom/linux": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout",
    "on-click-middle": "wofi --show drun --style ~/.config/wofi/style.css"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true
  },

  "hyprland/window": {
    "max-length": 50,
    "format": "<b>{title}</b>",
    "rewrite": {
      "(.*) - Brave": "$1",
      "(.*) - Visual Studio Code": "$1",
      "(.*) - Kitty": "$1"
    }
  },

  "clock": {
    "interval": 60,
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode"          : "month",
      "mode-mon-col"  : 3,
      "on-scroll"     : 1,
      "format": {
        "months":     "<span color='#88c0d0'><b>{}</b></span>",
        "days":       "<span color='#e5e9f0'><b>{}</b></span>",
        "weekdays":   "<span color='#81a1c1'><b>{}</b></span>",
        "today":      "<span color='#bf616a'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu": {
    "format": "󰍛 {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": "󰘚 {used:0.1f}G",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G",
    "on-click": "flatpak run io.missioncenter.MissionCenter"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "blueman-manager"
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "swaync-client -t -sw",
    "tooltip-format": "Brightness: {percent}%"
  },

  "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "pavucontrol",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "Volume: {volume}%"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 35,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery: {capacity}%",
    "on-click": "kitty -e battop"
  },

  "custom/controlcenter": {
    "format": "",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "tray": {
    "icon-size": 19,
    "spacing": 7
  }
}
