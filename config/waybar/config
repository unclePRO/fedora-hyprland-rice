{
  "layer": "top",
  "position": "top",
  "height": 35,
  "margin": 0,
  "spacing": 8,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "wireplumber",
    "bluetooth",
    "network",
    "cpu",
    "temperature",
    "memory",
    "battery",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi --show drun",
    "on-click-middle": "wofi --show run"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true
  },

  "hyprland/window": {
    "max-length": 50,
    "format": "{title}",
    "rewrite": {
      "(.*) - Brave": "  $1",
      "(.*) - Visual Studio Code": "  $1",
      "(.*) - Kitty": "  $1"
    }
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "on-click": "pavucontrol",
    "format-icons": ["", "", ""]
  },

  "bluetooth": {
    "format": "",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "interval": 30,
    "exec": "rfkill list bluetooth | grep -q 'soft: yes' && echo 'disabled' || (bluetoothctl info | grep -q 'Device' && echo 'connected' || echo 'on')"
  },

  "network": {
    "interface": "enp*", 
    "format-ethernet": "󰈀", 
    "format-wifi": "  {essid}",       
    "format-disconnected": "⚠",
    "tooltip-format": "{ifname} via {gwaddr}", 
    "on-click": "nm-connection-editor"         
  },

  "cpu": {
    "format": " {usage:2}%",
    "on-click": "flatpak run io.missioncenter.MissionCenter"
  },

  "temperature": {
    "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon8/temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-critical": "🔥 {temperatureC}°C",
    "format-icons": ["", "", ""],
    "tooltip": true,
    "tooltip-format": "CPU Temperature",
    "on-click": "kitty -e btop" 
  },

  "memory": {
    "format": "  {used:0.1f}G",
    "on-click": "flatpak run io.missioncenter.MissionCenter"
  },

  "battery": {
    "states": {
      "good": 0.7,
      "warning": 0.35,
      "critical": 0.15
    },
    "format": "{icon}  {capacity:2}%",
    "format-charging": "  {capacity:2}%",
    "format-icons": ["", "", "", "", ""],
    "on-click": "kitty -e ~/.local/bin/battop"
  },

  "clock": {
    "interval": 60,
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a %d %b %Y}",
    "tooltip-format": "{:%A, %d %B %Y %H:%M}"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout --protocol layer-shell"
 }
}
